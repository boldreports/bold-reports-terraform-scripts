{
  "properties": {
    "roleName": "Terraform Minimal Deployment Role",
    "description": "Provides the minimum required permissions for Terraform to deploy and manage Azure infrastructure resources without using the built-in Contributor role.",
    "assignableScopes": [
      "/subscriptions/<Subscriptions_ID>"
    ],
    "permissions": [
      {
        "actions": [
          "Microsoft.Resources/subscriptions/resourceGroups/read",
          "Microsoft.Resources/deployments/*",
          "Microsoft.Resources/subscriptions/resourceGroups/write",
          "Microsoft.Resources/subscriptions/resourceGroups/delete",

          "Microsoft.Network/virtualNetworks/*",
          "Microsoft.Network/virtualNetworks/subnets/*",
          "Microsoft.Network/privateEndpoints/*",
          "Microsoft.Network/privateDnsZones/*",
          "Microsoft.Network/publicIPAddresses/*",

          "Microsoft.ContainerService/managedClusters/*",
          "Microsoft.Kubernetes/*",

          "Microsoft.DBforPostgreSQL/flexibleServers/*",

          "Microsoft.Storage/storageAccounts/*",

          "Microsoft.Authorization/roleAssignments/read",
          "Microsoft.Authorization/roleAssignments/write",

          "Microsoft.OperationalInsights/workspaces/*",
          "Microsoft.Insights/components/*"
        ],
        "notActions": [],
        "dataActions": [],
        "notDataActions": []
      }
    ]
  }
}
